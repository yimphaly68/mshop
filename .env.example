# Copy this file to .env for local development, or set these as environment
# variables in your hosting provider (e.g. Render's dashboard).
# None of these are required to run the app locally — without them it uses
# a local SQLite database and stores photos in static/uploads/.

# Postgres connection string (e.g. from Supabase: Project Settings > Database)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Cloudinary connection string (Cloudinary Dashboard > Account Details)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Random secret used to sign session cookies / flash messages
# SECRET_KEY=change-me-to-something-random

# Login (HTTP Basic Auth). Leave all four unset to run with no login at all
# (e.g. local development). Set all four to require a login — admin can
# delete records, staff cannot. Generate a hash with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('the-password'))"
# AUTH_ADMIN_USERNAME=Yimphaly
# AUTH_ADMIN_PASSWORD_HASH=scrypt:...
# AUTH_STAFF_USERNAME=Oumsetha
# AUTH_STAFF_PASSWORD_HASH=scrypt:...

# Telegram notifications when an item, sale, advertising expense, or other
# expense is added. Leave both unset to disable (default). To enable:
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts —
#      you'll get a bot token like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   2. Add the bot to your Telegram group
#   3. Get the group's chat ID (e.g. open
#      https://api.telegram.org/bot<TOKEN>/getUpdates after sending any
#      message in the group, and read the "chat":{"id": ...} value — it's
#      usually a negative number for groups)
# TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=-1001234567890
